// {{ComponentName}} — Console I/O stub
using System;
using System.Linq;

namespace {{ComponentName}}
{
    public static class ConsoleIO
    {
        public static void PrintLine(string message)
        {
            Console.WriteLine(message);
        }

        public static void Print(string message)
        {
            Console.Write(message);
        }

        public static string ReadLine()
        {
            return Console.ReadLine() ?? "";
        }

        public static string[] ReadSplitLine(string delimiter)
        {
            var line = Console.ReadLine() ?? "";
            return line.Split(new[] { delimiter }, StringSplitOptions.None);
        }

        public static string[] ReadArgs()
        {
            var line = Console.ReadLine() ?? "";
            return line.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        }

        public static void PrintError(string text)
        {
            Console.Error.WriteLine(text);
        }

        public static void PrintResult(string text)
        {
            Console.WriteLine(text);
        }

        public static void ClearScreen()
        {
            Console.Clear();
        }

        public static string ReadKey()
        {
            return Console.ReadKey(true).KeyChar.ToString();
        }

        public static string ReadChar()
        {
            return Console.ReadKey(true).KeyChar.ToString();
        }
    }
}