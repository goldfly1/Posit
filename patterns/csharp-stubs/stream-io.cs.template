using System;
using System.Collections.Generic;
using System.IO;

namespace {{ComponentName}}
{
    public static partial class StreamIO
    {
        private static readonly Dictionary<int, StreamReader> _streams = new();
        private static int _nextStreamId = 1;

        // Portal: OpenStream(path: string) returns (streamId: int)
        // requires |path| > 0
        // ensures streamId >= 0
        public static int OpenStream(string path)
        {
            if (string.IsNullOrEmpty(path))
                throw new ArgumentException("requires |path| > 0", nameof(path));

            var sr = new StreamReader(path);
            var id = _nextStreamId++;
            _streams[id] = sr;
            return id;
        }

        // Portal: ReadChunk(streamId: int, maxBytes: int) returns (chunk: string)
        // requires streamId >= 0
        // requires maxBytes > 0
        // ensures |chunk| >= 0
        public static string ReadChunk(int streamId, int maxBytes)
        {
            if (streamId < 0)
                throw new ArgumentException("requires streamId >= 0", nameof(streamId));
            if (maxBytes <= 0)
                throw new ArgumentException("requires maxBytes > 0", nameof(maxBytes));

            if (!_streams.TryGetValue(streamId, out var sr))
                return "";

            var buffer = new char[maxBytes];
            var read = sr.Read(buffer, 0, maxBytes);
            return read > 0 ? new string(buffer, 0, read) : "";
        }

        // Portal: CloseStream(streamId: int)
        // requires streamId >= 0
        public static void CloseStream(int streamId)
        {
            if (streamId < 0)
                throw new ArgumentException("requires streamId >= 0", nameof(streamId));

            if (_streams.TryGetValue(streamId, out var sr))
            {
                sr.Close();
                _streams.Remove(streamId);
            }
        }

        // Portal: HasMore(streamId: int) returns (hasMore: bool)
        // requires streamId >= 0
        public static bool HasMore(int streamId)
        {
            if (streamId < 0)
                throw new ArgumentException("requires streamId >= 0", nameof(streamId));

            if (!_streams.TryGetValue(streamId, out var sr))
                return false;
            return !sr.EndOfStream;
        }
    }
