        // Portal: OpenSocket(host: string, port: int) returns (socketId: int)
        // requires |host| > 0
        // requires port > 0
        // ensures socketId >= 0
        public static int OpenSocket(string host, int port)
        {
            if (string.IsNullOrEmpty(host))
                throw new ArgumentException("requires |host| > 0", nameof(host));
            if (port <= 0)
                throw new ArgumentException("requires port > 0", nameof(port));

            var client = new TcpClient(host, port);
            var socketId = _nextSocketId++;
            _sockets[socketId] = client;
            return socketId;
        }

        // Portal: SocketSend(socketId: int, data: string)
        // requires socketId >= 0
        public static void SocketSend(int socketId, string data)
        {
            if (socketId < 0)
                throw new ArgumentException("requires socketId >= 0", nameof(socketId));
            if (!_sockets.TryGetValue(socketId, out var client))
                throw new InvalidOperationException($"Socket {socketId} not found");

            var stream = client.GetStream();
            var bytes = Encoding.UTF8.GetBytes(data ?? "");
            stream.Write(bytes, 0, bytes.Length);
        }

        // Portal: SocketRecv(socketId: int) returns (data: string)
        // requires socketId >= 0
        // ensures |data| >= 0
        public static string SocketRecv(int socketId)
        {
            if (socketId < 0)
                throw new ArgumentException("requires socketId >= 0", nameof(socketId));
            if (!_sockets.TryGetValue(socketId, out var client))
                throw new InvalidOperationException($"Socket {socketId} not found");

            var stream = client.GetStream();
            var buffer = new byte[4096];
            var bytesRead = stream.Read(buffer, 0, buffer.Length);
            return bytesRead > 0 ? Encoding.UTF8.GetString(buffer, 0, bytesRead) : "";
        }

        // Portal: CloseSocket(socketId: int)
        // requires socketId >= 0
        public static void CloseSocket(int socketId)
        {
            if (socketId < 0)
                throw new ArgumentException("requires socketId >= 0", nameof(socketId));
            if (_sockets.TryGetValue(socketId, out var client))
            {
                client.Close();
                _sockets.Remove(socketId);
            }
        }
