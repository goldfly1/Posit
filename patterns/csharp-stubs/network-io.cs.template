    public static partial class NetworkIO
    {
        private static readonly HttpClient _client = new();

        // Socket pool: socketId → TcpClient
        private static readonly Dictionary<int, TcpClient> _sockets = new();
        private static int _nextSocketId = 1;

        // Portal: HttpGet(url: string) returns (response: string)
