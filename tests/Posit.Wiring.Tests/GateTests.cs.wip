using Posit.Contracts.Artifacts;
using Posit.Contracts.Core;
using Posit.Phases;

/// <summary>
/// Canonical gate tests — deterministic, in-process, no LLM, no Docker.
/// Tests ContractFidelityChecker, ContractScanner, TypeChainChecker, and
/// the interface sanitizer. These replace the throwaway ad-hoc probes.
/// </summary>
public static class GateTests
{
    public static int Run()
    {
        var passCount = 0;
        var failures = new List<string>();

        // Helper to run a test
        void Test(string name, Action action)
        {
            try
            {
                action();
                Interlocked.Increment(ref passCount);
                Console.WriteLine($"  [PASS] {name}");
            }
            catch (Exception ex)
            {
                failures.Add($"{name}: {ex.Message}");
                Console.WriteLine($"  [FAIL] {name} — {ex.Message}");
            }
        }

        // Helper to assert
        void Assert(bool condition, string message)
        {
            if (!condition) throw new Exception(message);
        }

        // ── ContractFidelityChecker tests ──

        Test("fidelity:cc-limit-default-is-5", () =>
        {
            ContractFidelityChecker.ResetCcLimit();
            // CC limit is static — we can't read it directly, but we can verify
            // that ResetCcLimit exists and doesn't throw
            Assert(true, "ResetCcLimit should not throw");
        });

        Test("fidelity:degenerate-contract-rejected", () =>
        {
            ContractFidelityChecker.ResetCcLimit();
            var spec = "Read a CSV file, filter rows, count results, and print the count.";
            var contract = new ArchitectureContract
            {
                SpecText = spec,
                Components = new[]
                {
                    new Component
                    {
                        Name = "Cli",
                        Classification = ModuleClassification.IoShell,
                        EntryType = "file",
                        Connections = new[]
                        {
                            new ConnectionSpec("Run", "Logic", "DoEverything", Array.Empty<string>())
                        },
                        MethodSignatures = Array.Empty<MethodSignature>(),
                        TestCases = Array.Empty<ComponentTestCase>()
                    },
                    new Component
                    {
                        Name = "Logic",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("DoEverything", new[] { new MethodParam("input", "string[]") }, "int")
                        },
                        TestCases = Array.Empty<ComponentTestCase>()
                    }
                }
            };
            var errors = ContractFidelityChecker.Check(contract, spec);
            Assert(errors.Count > 0, "Degenerate contract (1 method for 3-verb spec) should be rejected");
            Assert(errors.Any(e => e.Rule.Contains("degenerate")), $"Expected degenerate error, got: {string.Join(", ", errors.Select(e => e.Rule))}");
        });

        Test("fidelity:non-native-return-rejected", () =>
        {
            ContractFidelityChecker.ResetCcLimit();
            var spec = "Read a file and produce a report.";
            var contract = new ArchitectureContract
            {
                SpecText = spec,
                Components = new[]
                {
                    new Component
                    {
                        Name = "Cli",
                        Classification = ModuleClassification.IoShell,
                        EntryType = "file",
                        Connections = new[]
                        {
                            new ConnectionSpec("Run", "Logic", "GenerateReport", Array.Empty<string>())
                        },
                        MethodSignatures = Array.Empty<MethodSignature>(),
                        TestCases = new[]
                        {
                            new ComponentTestCase("tc1", "test", "Logic", "report", "Valid: 2")
                        }
                    },
                    new Component
                    {
                        Name = "Logic",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("GenerateReport", new[] { new MethodParam("input", "string[]") }, "ValidationReport")
                        },
                        TestCases = Array.Empty<ComponentTestCase>()
                    }
                }
            };
            var errors = ContractFidelityChecker.Check(contract, spec);
            Assert(errors.Any(e => e.Rule == "non-native-return-no-format"),
                $"Expected non-native-return-no-format, got: {string.Join(", ", errors.Select(e => e.Rule))}");
        });

        Test("fidelity:missing-output-format-rejected", () =>
        {
            ContractFidelityChecker.ResetCcLimit();
            var spec = "Read a log file, count errors, print 'ERROR: N'.";
            var contract = new ArchitectureContract
            {
                SpecText = spec,
                Components = new[]
                {
                    new Component
                    {
                        Name = "Cli",
                        Classification = ModuleClassification.IoShell,
                        EntryType = "file",
                        Connections = new[]
                        {
                            new ConnectionSpec("Run", "Logic", "CountErrors", Array.Empty<string>())
                        },
                        MethodSignatures = Array.Empty<MethodSignature>(),
                        TestCases = new[]
                        {
                            new ComponentTestCase("tc1", "test", "Logic", "error count", "ERROR: 2")
                            {
                                CliArgs = "ERROR"
                            }
                        }
                    },
                    new Component
                    {
                        Name = "Logic",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("CountErrors", new[] { new MethodParam("lines", "string[]"), new MethodParam("level", "string") }, "int")
                        },
                        TestCases = Array.Empty<ComponentTestCase>()
                    }
                }
            };
            var errors = ContractFidelityChecker.Check(contract, spec);
            Assert(errors.Any(e => e.Rule == "missing-output-format"),
                $"Expected missing-output-format, got: {string.Join(", ", errors.Select(e => e.Rule))}");
        });

        Test("fidelity:clean-contract-passes", () =>
        {
            ContractFidelityChecker.ResetCcLimit();
            var spec = "Read a text file and print it to stdout in uppercase.";
            var contract = new ArchitectureContract
            {
                SpecText = spec,
                Components = new[]
                {
                    new Component
                    {
                        Name = "Cli",
                        Classification = ModuleClassification.IoShell,
                        EntryType = "file",
                        Connections = new[]
                        {
                            new ConnectionSpec("Run", "Logic", "Transform", Array.Empty<string>())
                        },
                        MethodSignatures = Array.Empty<MethodSignature>(),
                        TestCases = new[]
                        {
                            new ComponentTestCase("tc1", "test", "Logic", "uppercase", "HELLO WORLD")
                        }
                    },
                    new Component
                    {
                        Name = "Logic",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("Transform", new[] { new MethodParam("input", "string") }, "string")
                        },
                        TestCases = Array.Empty<ComponentTestCase>()
                    }
                }
            };
            var errors = ContractFidelityChecker.Check(contract, spec);
            Assert(errors.Count == 0, $"Clean contract should pass, got errors: {string.Join(", ", errors.Select(e => e.Rule))}");
        });

        // ── ContractScanner tests ──

        Test("scanner:clean-interface-passes", () =>
        {
            var iface = """
namespace Test {
    public interface ITest {
        string Transform(string input);
    }
}
""";
            // ContractScanner.Scan needs a contract and registry — test via static method
            // We verify the scanner doesn't reject a clean interface
            var contract = MakeMinimalContract("Test", iface);
            var errors = ContractScanner.Scan(contract, new PatternRegistry());
            var ifaceErrors = errors.Where(e => e.Field == "csharpInterface").ToList();
            Assert(ifaceErrors.Count == 0, $"Clean interface should pass, got: {string.Join(", ", ifaceErrors.Select(e => e.Message))}");
        });

        Test("scanner:rejects-for-in-interface", () =>
        {
            var iface = """
namespace Test {
    public interface ITest {
        string Transform(string input);
        for (int i = 0; i < n; i++) { }
    }
}
""";
            var contract = MakeMinimalContract("Test", iface);
            var errors = ContractScanner.Scan(contract, new PatternRegistry());
            Assert(errors.Any(e => e.Message.Contains("for") && e.Field == "csharpInterface"),
                $"Should reject 'for' in interface, got: {string.Join(", ", errors.Select(e => e.Message))}");
        });

        Test("scanner:allows-for-in-doc-comment", () =>
        {
            var iface = """
namespace Test {
    public interface ITest {
        /// <summary>Overrides file1 for duplicate keys.</summary>
        string Merge(string[] file1, string[] file2);
    }
}
""";
            var contract = MakeMinimalContract("Test", iface);
            var errors = ContractScanner.Scan(contract, new PatternRegistry());
            var ifaceErrors = errors.Where(e => e.Field == "csharpInterface").ToList();
            Assert(ifaceErrors.Count == 0,
                $"'for' in doc comment should NOT trigger rejection, got: {string.Join(", ", ifaceErrors.Select(e => e.Message))}");
        });

        // ── TypeChainChecker tests ──

        Test("typechain:type-collision-detected", () =>
        {
            var contract = new ArchitectureContract
            {
                SpecText = "test",
                Components = new[]
                {
                    new Component
                    {
                        Name = "ComponentA",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("DoA", Array.Empty<MethodParam>(), "PriceConverter")
                        },
                        Connections = Array.Empty<ConnectionSpec>(),
                        TestCases = Array.Empty<ComponentTestCase>()
                    },
                    new Component
                    {
                        Name = "ComponentB",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("DoB", new[] { new MethodParam("data", "PriceConverter") }, "string")
                        },
                        Connections = Array.Empty<ConnectionSpec>(),
                        TestCases = Array.Empty<ComponentTestCase>()
                    }
                }
            };
            var errors = TypeChainChecker.CheckPreImpl(contract);
            Assert(errors.Count > 0, "Type collision (PriceConverter in two components) should be detected");
        });

        Test("typechain:no-collision-for-native-types", () =>
        {
            var contract = new ArchitectureContract
            {
                SpecText = "test",
                Components = new[]
                {
                    new Component
                    {
                        Name = "ComponentA",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("DoA", Array.Empty<MethodParam>(), "string")
                        },
                        Connections = Array.Empty<ConnectionSpec>(),
                        TestCases = Array.Empty<ComponentTestCase>()
                    },
                    new Component
                    {
                        Name = "ComponentB",
                        Classification = ModuleClassification.Logic,
                        MethodSignatures = new[]
                        {
                            new MethodSignature("DoB", new[] { new MethodParam("data", "string") }, "int")
                        },
                        Connections = Array.Empty<ConnectionSpec>(),
                        TestCases = Array.Empty<ComponentTestCase>()
                    }
                }
            };
            var errors = TypeChainChecker.CheckPreImpl(contract);
            var collisionErrors = errors.Where(e => e.CurrentReturnType == e.ExpectedParamType
                && e.CurrentReturnType != "string" && e.CurrentReturnType != "int").ToList();
            Assert(collisionErrors.Count == 0, "Native types (string, int) should not trigger collision");
        });

        // ── Summary ──
        Console.WriteLine($"\n{passCount} gate tests passed");
        if (failures.Count > 0)
        {
            Console.Error.WriteLine("GATE TESTS FAIL");
            foreach (var f in failures)
                Console.Error.WriteLine($"  {f}");
            return 1;
        }
        Console.WriteLine("GATE TESTS PASS");
        return 0;
    }

    /// <summary>
    /// Build a minimal contract with one logic component carrying the given C# interface.
    /// </summary>
    private static ArchitectureContract MakeMinimalContract(string name, string csharpInterface)
    {
        return new ArchitectureContract
        {
            SpecText = "test spec",
            Components = new[]
            {
                new Component
                {
                    Name = name,
                    Classification = ModuleClassification.Logic,
                    CSharpInterface = csharpInterface,
                    MethodSignatures = new[]
                    {
                        new MethodSignature("Transform", new[] { new MethodParam("input", "string") }, "string")
                    },
                    Connections = Array.Empty<ConnectionSpec>(),
                    TestCases = Array.Empty<ComponentTestCase>()
                }
            }
        };
    }
}