<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <div style="background:#1e1e2e; color:#cdd6f4; min-height:100vh; padding:2rem; font-family:system-ui,sans-serif;">
            <h1 style="color:#f38ba8;">Page not found</h1>
            <p>The page you're looking for doesn't exist.</p>
        </div>
    </NotFound>
</Router>