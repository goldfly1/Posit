@page "/"
@inject Posit.Web.Data.QaDashboardRepository Repo
@using Posit.Web.Data

<PageTitle>Posit QA Dashboard</PageTitle>

<div style="background:#1e1e2e; color:#cdd6f4; min-height:100vh; padding:1.5rem; font-family:system-ui,sans-serif;">

    <h1 style="color:#89b4fa; margin:0 0 1rem 0;">⚡ Posit QA Dashboard</h1>

    <!-- Session selector -->
    <div style="margin-bottom:1.5rem;">
        <label style="display:block; color:#9399b2; margin-bottom:0.3rem; font-size:0.9rem;">Session:</label>
        <select @bind="selectedSessionId" @bind:after="OnSessionSelected"
                style="background:#313244; color:#cdd6f4; border:1px solid #45475a; border-radius:6px; padding:0.5rem 1rem; min-width:600px;">
            <option value="">— Choose a session —</option>
            @foreach (var s in sessions)
            {
                <option value="@s.SessionId">@s.ShortId… · @s.Status · @s.SavedAt.ToString("MM-dd HH:mm") · @s.ShortRequest</option>
            }
        </select>
    </div>

    @if (loading)
    {
        <p style="color:#9399b2;">Loading…</p>
    }

    @if (selectedSession != null)
    {
        <!-- Session summary -->
        <div style="display:flex; gap:2rem; flex-wrap:wrap; margin-bottom:1.5rem; padding:1rem; background:#181825; border-radius:8px; border:1px solid #313244;">
            <div><span style="color:#9399b2;">Status:</span> <span style="color:@GetStatusColor(selectedSession.Status); font-weight:600;">@selectedSession.Status</span></div>
            <div><span style="color:#9399b2;">Session:</span> @selectedSession.SessionId</div>
            <div><span style="color:#9399b2;">Saved:</span> @selectedSession.SavedAt.ToString("yyyy-MM-dd HH:mm")</div>
        </div>

        <!-- Request -->
        @if (!string.IsNullOrEmpty(selectedSession.Request))
        {
            <div style="margin-bottom:1.5rem; padding:1rem; background:#181825; border-radius:8px; border:1px solid #313244;">
                <span style="color:#9399b2; font-size:0.85rem;">Request:</span>
                <p style="color:#cdd6f4; margin:0.3rem 0 0 0; font-size:0.9rem;">@selectedSession.Request</p>
            </div>
        }

        <!-- Pipeline phases -->
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:1.5rem;">
            @foreach (var phase in Phases)
            {
                <div style="padding:0.6rem 1rem; border-radius:6px; min-width:100px; text-align:center; border:2px solid; @GetPhaseStyle(phase)">
                    <div style="font-weight:600; font-size:0.85rem;">@phase</div>
                </div>
                <span style="color:#45475a; align-self:center; font-size:1.2rem;">→</span>
            }
        </div>

        <!-- Artifacts list -->
        <div style="margin-bottom:1.5rem;">
            <h2 style="color:#89b4fa; font-size:1.1rem; margin-bottom:0.5rem;">Artifacts (@artifacts.Count)</h2>
            <table style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="border-bottom:1px solid #313244;">
                        <th style="text-align:left; padding:0.4rem; color:#9399b2; font-size:0.8rem;">Phase</th>
                        <th style="text-align:left; padding:0.4rem; color:#9399b2; font-size:0.8rem;">Kind</th>
                        <th style="text-align:left; padding:0.4rem; color:#9399b2; font-size:0.8rem;">Produced</th>
                        <th style="text-align:left; padding:0.4rem; color:#9399b2; font-size:0.8rem;">Preview</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in artifacts)
                    {
                        <tr style="border-bottom:1px solid #181825;">
                            <td style="padding:0.4rem; font-size:0.85rem;">@a.SourcePhase</td>
                            <td style="padding:0.4rem; font-size:0.85rem; color:#89b4fa;">@a.Kind</td>
                            <td style="padding:0.4rem; font-size:0.8rem; color:#9399b2;">@a.ProducedAt.ToString("HH:mm:ss")</td>
                            <td style="padding:0.4rem; font-size:0.8rem; color:#585b70; max-width:400px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(a.PayloadJson.Length > 80 ? a.PayloadJson[..80] + "…" : a.PayloadJson)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- QA Test Suite -->
        @if (testSuite != null)
        {
            <div style="background:#181825; border-radius:8px; border:1px solid #313244; padding:1.5rem; margin-bottom:1.5rem;">
                <h2 style="color:#89b4fa; margin:0 0 0.5rem 0;">QA Test Suite</h2>
                <p style="color:#9399b2; font-size:0.85rem; margin:0 0 1rem 0;">@testSuite.Summary</p>

                <h3 style="color:#cdd6f4; font-size:0.95rem; margin-bottom:0.5rem;">Test Data Files (@testSuite.TestFiles.Count)</h3>
                <div style="display:grid; gap:0.8rem;">
                    @for (var i = 0; i < testSuite.TestFiles.Count; i++)
                    {
                        var file = testSuite.TestFiles[i];
                        var key = $"tc{i + 1}";
                        var hasExpected = testSuite.ExpectedOutputs.TryGetValue(key, out var expected);
                        var exitCode = testSuite.ExpectedExitCodes.TryGetValue(key, out var ec) ? ec : 0;
                        <div style="background:#1e1e2e; border-radius:6px; padding:0.8rem; border:1px solid #313244;">
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.3rem;">
                                <span style="color:#89b4fa; font-size:0.85rem; font-weight:600;">@file.Path</span>
                                <span style="color:@(exitCode == 0 ? "#a6e3a1" : "#f38ba8"); font-size:0.8rem;">exit @(exitCode)</span>
                            </div>
                            <pre style="background:#11111b; color:#cdd6f4; padding:0.5rem; border-radius:4px; font-size:0.75rem; white-space:pre-wrap; max-height:150px; overflow:auto; margin:0;">@file.Content</pre>
                            @if (hasExpected && !string.IsNullOrEmpty(expected))
                            {
                                <div style="margin-top:0.3rem;">
                                    <span style="color:#9399b2; font-size:0.75rem;">Expected output:</span>
                                    <pre style="background:#11111b; color:#a6e3a1; padding:0.3rem; border-radius:4px; font-size:0.75rem; white-space:pre-wrap; margin:0.2rem 0 0 0;">@expected</pre>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (!loading)
        {
            <div style="background:#181825; border-radius:8px; border:1px solid #313244; padding:1.5rem;">
                <p style="color:#9399b2;">No TestSuite artifact found for this session.</p>
            </div>
        }
    }

</div>

@code {
    private List<SessionSummary> sessions = new();
    private SessionSummary? selectedSession;
    private string selectedSessionId = "";
    private bool loading;
    private List<ArtifactSummary> artifacts = new();
    private TestSuiteData? testSuite;

    private static readonly string[] Phases = ["Architecture", "C#Impl", "QA", "Docker Harness"];

    protected override async Task OnInitializedAsync()
    {
        try { sessions = await Repo.GetSessionsAsync(); }
        catch (Exception ex) { Console.Error.WriteLine($"Failed to load sessions: {ex}"); }
    }

    private async Task OnSessionSelected()
    {
        if (string.IsNullOrEmpty(selectedSessionId))
        {
            selectedSession = null;
            artifacts.Clear();
            testSuite = null;
            return;
        }

        loading = true;
        selectedSession = sessions.FirstOrDefault(s => s.SessionId == selectedSessionId);

        try
        {
            artifacts = await Repo.GetArtifactsAsync(selectedSessionId);
            testSuite = await Repo.GetTestSuiteAsync(selectedSessionId);
        }
        catch (Exception ex) { Console.Error.WriteLine($"Failed to load artifacts: {ex}"); }
        finally { loading = false; }
    }

    private static string GetStatusColor(string status) => status.ToLowerInvariant() switch
    {
        "completed" => "#a6e3a1",
        "active" or "running" => "#89b4fa",
        "paused" => "#f9e2af",
        "failed" or "abandoned" or "aborted" => "#f38ba8",
        _ => "#cdd6f4"
    };

    private string GetPhaseStyle(string phase)
    {
        if (selectedSession == null) return "background:#313244; color:#9399b2; border-color:#45475a;";
        if (selectedSession.Status == "completed") return "background:#a6e3a1; color:#1e1e2e; border-color:#40602d;";
        if (selectedSession.Phase?.Equals(phase, StringComparison.OrdinalIgnoreCase) == true)
            return "background:#89b4fa; color:#1e1e2e; border-color:#cdd6f4;";
        return "background:#313244; color:#9399b2; border-color:#45475a;";
    }
}