@page "/"
@using Posit.Contracts.Core
@using Posit.Data.Repositories
@inject ArtifactRepository ArtifactRepo

<h1>Posit Desktop</h1>

<p>Live sessions from the posit_artifacts store.</p>

@if (_sessions == null)
{
    <p>Loading...</p>
}
else if (_sessions.Count == 0)
{
    <p>No sessions found.</p>
}
else
{
    <ul>
        @foreach (var s in _sessions)
        {
            <li>
                <strong>@s.Value</strong>
                <a href="/sessions/@s.Key">View artifacts</a>
            </li>
        }
    </ul>
}

@code {
    private Dictionary<string, string>? _sessions;

    protected override async Task OnInitializedAsync()
    {
        var list = await ArtifactRepo.ListSessionsAsync();
        _sessions = list.ToDictionary(s => s.Value, s => s.Value);
    }
}
