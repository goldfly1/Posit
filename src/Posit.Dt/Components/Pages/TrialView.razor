@page "/trial/{SessionId}"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject PositDashboardRepository Repo
@inject PositTrialRepository TrialRepo

<PageTitle>Trial @SessionId[..Math.Min(12, SessionId.Length)] — Posit</PageTitle>

<div class="page-header">
    <h1 style="color:#89b4fa; margin:0;">Trial Results</h1>
    <div>
        <button @onclick="RefreshAsync" class="btn btn-primary" accesskey="r" title="Refresh (Alt+R)">↻ Refresh</button>
        <a href="/sessions" class="btn btn-secondary" accesskey="b" title="Back (Alt+B)">← Back</a>
    </div>
</div>

@if (loading)
{
    <p>Loading trial…</p>
}
else if (summary == null)
{
    <p>Session not found.</p>
}
else
{
    <!-- Session summary -->
    <div class="trial-section">
        <h2 accesskey="s" title="Session info (Alt+S)">Session</h2>
        <table class="data-table">
            <tr><td>ID</td><td>@summary.SessionId</td></tr>
            <tr><td>Status</td><td><span class="badge" style="@GetStatusStyle(summary.Status)">@summary.Status</span></td></tr>
            <tr><td>Phase</td><td>@(summary.CurrentPhaseId ?? "—")</td></tr>
            <tr><td>Spec</td><td>@(summary.Description ?? "—")</td></tr>
            <tr><td>Tokens</td><td>@summary.InputTokens in / @summary.OutputTokens out</td></tr>
        </table>
    </div>

    <!-- Test results -->
    @if (testResults != null && testResults.Length > 0)
    {
        <div class="trial-section">
            <h2 accesskey="t" title="Test results (Alt+T)">Test Results (@testResults.Length)</h2>
            <table class="data-table">
                <thead>
                    <tr><th>ID</th><th>Name</th><th>Result</th><th>Output</th></tr>
                </thead>
                <tbody>
                    @foreach (var tc in testResults)
                    {
                        <tr>
                            <td>@tc.Id</td>
                            <td>@tc.Name</td>
                            <td>
                                @if (tc.Matches)
                                {
                                    <span class="badge" style="background:#a6e3a1; color:#1e1e2e;">PASS</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#f38ba8; color:#1e1e2e;">FAIL</span>
                                }
                            </td>
                            <td><pre style="max-height:200px; overflow:auto; white-space:pre-wrap;">@tc.Output</pre></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Generated Wire.cs -->
    @if (!string.IsNullOrEmpty(wireCs))
    {
        <div class="trial-section">
            <h2 accesskey="w" title="Wire.cs (Alt+W)">Wire.cs (auto-generated wiring)</h2>
            <pre class="code-block">@wireCs</pre>
        </div>
    }

    <!-- Components -->
    @if (components != null && components.Length > 0)
    {
        <div class="trial-section">
            <h2 accesskey="c" title="Components (Alt+C)">Components (@components.Length)</h2>
            <table class="data-table">
                <thead>
                    <tr><th>Name</th><th>Pattern</th><th>Classification</th><th>Connections</th><th>Verified</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in components)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td>@(c.PatternName ?? "—")</td>
                            <td>@c.Classification</td>
                            <td>@c.Connections</td>
                            <td>@(c.IsVerified ? "✅" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- QA Analysis -->
    @if (!string.IsNullOrEmpty(qaAnalysis))
    {
        <div class="trial-section">
            <h2 accesskey="q" title="QA analysis (Alt+Q)">QA Analysis</h2>
            <pre class="code-block">@qaAnalysis</pre>
        </div>
    }
}

@code {
    [Parameter] public string SessionId { get; set; } = "";
    private PositSessionSummary? summary;
    private Posit.Dt.Data.TestCaseResultDto[]? testResults;
    private string wireCs = "";
    private Posit.Dt.Data.ComponentDto[]? components;
    private string qaAnalysis = "";
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        loading = true;
        try
        {
            summary = await Repo.GetSessionSummaryAsync(SessionId);
            var trialData = await TrialRepo.GetTrialDataAsync(SessionId);
            testResults = trialData.TestResults;
            wireCs = trialData.WireCs;
            components = trialData.Components;
            qaAnalysis = trialData.QaAnalysis;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load trial: {ex}");
        }
        loading = false;
    }

    private static string GetStatusStyle(string status) => status.ToLowerInvariant() switch
    {
        "completed" => "background:#a6e3a1; color:#1e1e2e;",
        "aborted" or "failed" => "background:#f38ba8; color:#1e1e2e;",
        _ => "background:#313244; color:#cdd6f4;"
    };
}